{
  "name": "gro-kan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3030",
    "dev:safe": "npm run test:unit && npm run dev",
    "build": "next build",
    "build:full": "npx tsx scripts/ensure-db.ts && next build",
    "start": "next start -p 3030",
    "test": "playwright test",
    "test:iphone-14-plus": "playwright test --project=\"iPhone 14 Plus\"",
    "test:iphone-15": "playwright test --project=\"iPhone 15\"",
    "test:iphone-15-pro": "playwright test --project=\"iPhone 15 Pro\"",
    "test:iphone-17": "playwright test --project=\"iPhone 17\"",
    "test:iphone-17-pro": "playwright test --project=\"iPhone 17 Pro\"",
    "test:iphone-17-air": "playwright test --project=\"iPhone Air\"",
    "test:iphone": "playwright test --project=\"iPhone 15\" --project=\"iPhone 15 Pro\" --project=\"iPhone 17\" --project=\"iPhone 17 Pro\" --project=\"iPhone Air\"",
    "test:iphone-all-modern": "npm run test:iphone",
    "test:mobile-devices": "playwright test e2e/mobile-devices.spec.ts --project=chromium",
    "test:generate-iphone": "npx tsx scripts/generate-iphone-tests.ts",
    "test:generate-iphone-14-plus": "npx tsx scripts/generate-iphone-14-plus-tests.ts",
    "test:all": "npx tsx scripts/run-all-tests.ts",
    "test:unit": "npx tsx scripts/guest-auth.test.ts && npx tsx scripts/app-pin.test.ts && npx tsx scripts/access-flow.test.ts && npx tsx scripts/access-flow.regression.test.ts && npx tsx scripts/superadmin.regression.test.ts && npx tsx scripts/cron-cleanup-gcs-upload.test.ts && npx tsx scripts/logout-redirect.test.ts && npx tsx scripts/health-readiness.test.ts && npx tsx scripts/statement-generator.test.ts && npx tsx scripts/pdf-generator.test.ts && npx tsx scripts/dashboard2-assets.test.ts && npx tsx scripts/payment-html.test.ts && npx tsx scripts/daily-payment-limit.test.ts && npx tsx scripts/topup-rules.test.ts && npx tsx scripts/transactions-balance-refresh.test.ts && npx tsx scripts/random-balance.test.ts && npx tsx scripts/qr-50-scenarios.test.ts",
    "test:dashboard2": "playwright test e2e/dashboard2-face-id.spec.ts e2e/dashboard2-george-key.spec.ts e2e/dashboard2-payment-html.spec.ts e2e/dashboard2-payment-history.spec.ts e2e/dashboard2-payment-refresh.spec.ts e2e/dashboard3-*.spec.ts --project=chromium",
    "test:dashboard3": "playwright test e2e/dashboard3-light.spec.ts e2e/dashboard3-pin.spec.ts e2e/dashboard3-payment-sheet.spec.ts e2e/dashboard3-payment-history.spec.ts e2e/dashboard3-payment-refresh.spec.ts e2e/dashboard3-tabs.spec.ts e2e/dashboard3-proxy-skip.spec.ts --project=chromium",
    "test:payment-html": "npx tsx scripts/payment-html.test.ts && playwright test e2e/dashboard2-payment-html.spec.ts e2e/dashboard2-payment-history.spec.ts --project=chromium",
    "test:safari-prod": "playwright test --config=playwright.safari-prod.config.ts",
    "test:nothing-phone-1": "playwright test --project=\"Nothing Phone 1\"",
    "lint": "eslint .",
    "cap:sync": "npx --no-install cap sync",
    "cap:open": "npx --no-install cap open android",
    "cap:build": "npm run build && npx --no-install cap sync",
    "cap:ios:sync": "npx --no-install cap sync ios",
    "cap:ios:open": "npx --no-install cap open ios",
    "cap:ios:sim": "bash scripts/ios-simulator-demo.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npx tsx --env-file=.env.local scripts/seed-users.ts",
    "db:seed-larsen-q2": "npx tsx --env-file=.env.local scripts/seed-larsenevans-q2.ts",
    "db:backfill-pdf-url": "npx tsx --env-file=.env.local scripts/backfill-pdf-url.ts",
    "db:setup-supabase": "npx tsx --env-file=.env.local scripts/setup-supabase-env.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@google-cloud/storage": "^8.2.0",
    "@radix-ui/react-label": "^2.1.8",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/blob": "^2.4.1",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.0",
    "better-auth": "^1.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.2",
    "framer-motion": "^13.2.0",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.3.11",
    "pg": "^8.21.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "@next/env": "^16.2.9",
    "@next/eslint-plugin-next": "^16.2.9",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@tauri-apps/cli": "^2.11.3",
    "@types/html2canvas": "^0.5.35",
    "@types/jest": "^29.5.12",
    "@types/node": "^24",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "@types/web-push": "^3.6.4",
    "canvg": "^4.0.3",
    "dompurify": "^3.4.14",
    "drizzle-kit": "^0.30.6",
    "eslint": "^10.5.0",
    "eslint-config-next": "^16.2.9",
    "jest": "^29.7.0",
    "lightningcss": "^1.33.0",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.2.0",
